# SUPABASE_URL: URL proyek Supabase ULT FKIP Unila (contoh: https://your-project.supabase.co)
# Konfigurasikan melalui panel Secrets di AI Studio.
SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_PUBLISHABLE_KEY: Publishable / Anon Key Supabase (sb_publishable_...)
# PENTING: JANGAN masukkan SUPABASE_SECRET_KEY ke dalam aplikasi Android.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
